# ===================================================================
# SMART ENGLISH LEARNING SYSTEM - TEMPLATE (.env.example)
# ===================================================================
# Hướng dẫn cho thành viên mới hoặc deploy:
# Copy file này thành file '.env' và điền các giá trị thực tế của bạn:
#   copy .env.example .env
# ===================================================================

# 1. Database Configuration (SQL Server)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SmartEnglishLearningDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_sql_password_here

# 2. JWT Security Key (256-bit Hex / Base64 string)
JWT_SECRET=your_jwt_secret_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000

# 3. Google Gemini / LLM Integration
AI_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_LLM_API_KEY=your_gemini_api_key_here
AI_LLM_MODEL=gemini-3.5-flash-lite
AI_LLM_MOCK_ENABLED=true

